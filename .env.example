# ---- Haul configuration (all optional) --------------------------------------
# Copy to .env and adjust. Every variable is prefixed with HAUL_.

# Where the database, thumbnails, temp files and media live
HAUL_DATA_DIR=/data
# Override media / temp locations (e.g. a large disk)
# HAUL_MEDIA_DIR=/mnt/storage/haul
# HAUL_TEMP_DIR=/tmp/haul

# Require this token on every API call. STRONGLY recommended when exposed beyond localhost.
# Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
HAUL_API_TOKEN=

# Browsers allowed to call the API from another origin (JSON list)
HAUL_CORS_ORIGINS=["http://localhost:5173"]

# Download manager
HAUL_MAX_CONCURRENT_DOWNLOADS=3
HAUL_MAX_AUTO_RETRIES=2
HAUL_MAX_FILESIZE_MB=0
HAUL_MAX_PLAYLIST_ITEMS=500

# Analysis
HAUL_EXTRACT_TIMEOUT=90
HAUL_INFO_CACHE_TTL=1800
HAUL_RATE_LIMIT_PER_MINUTE=60

# Allow links to private/LAN addresses (e.g. a NAS). Off by default (SSRF protection).
HAUL_ALLOW_PRIVATE_NETWORKS=false

# Tools (auto-detected when empty)
# HAUL_FFMPEG_PATH=/usr/bin/ffmpeg
# HAUL_JS_RUNTIME=node

# Serve the built PWA from the API process (set automatically in Docker)
# HAUL_FRONTEND_DIST=../frontend/dist

# docker-compose only
HAUL_PORT=8000
# HAUL_DOMAIN=haul.example.com
